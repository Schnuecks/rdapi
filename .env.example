PUID=1000
PGID=1000
TZ=Europe/Berlin
# Public host name of the API server (use a separate test subdomain first)
DOMAIN=rdapi.example.com
RESTART=unless-stopped
SECOPTS=no-new-privileges:true
STOPTIME=10s
SVC=rdapi
# When testing next to an existing API server: use names it does not use
# COMPOSE_PROJECT_NAME=rdapi-test
